{
  "name": "ai-design-workflow-monorepo",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test",
    "smoke": "node packages/cli/bin/design-workflow.mjs doctor examples/react-vite",
    "validate": "npm run test && npm run smoke",
    "sync:skill-scanner": "node scripts/sync-skill-scanner.mjs",
    "gui": "npm run build:preview -w @ai-design-workflow/gui && node packages/gui/src/server.mjs",
    "design:start": "node scripts/design-start.mjs",
    "install:gui-hook": "node scripts/install-gui-hook.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
